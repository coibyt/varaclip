DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_SITE_NAME="GlowReels"

# --- Video storage -------------------------------------------------------
# Leave the R2_* values empty to store uploads on local disk (./uploads) —
# fine for development only. For production create a Cloudflare R2 bucket,
# enable a public domain (or custom domain) on it, add a CORS rule allowing
# PUT from your site origin, then fill these in:
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL="https://media.example.com"
