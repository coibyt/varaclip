# MySQL (Hostinger: hPanel -> Databases -> MySQL). Dạng:
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET="change-me"
NEXT_PUBLIC_SITE_NAME="VaraClip"
NEXT_PUBLIC_SITE_URL="https://varaclip.com"

# --- Lưu video (BẮT BUỘC khi chạy thật trên Hostinger) ---------------------
# Hostinger xoá file ghi vào thư mục ứng dụng mỗi lần deploy, nên video phải
# nằm ở Cloudflare R2. Để trống R2_* = lưu ./uploads (chỉ dùng khi phát triển).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL="https://media.varaclip.com"


# Accounts allowed to open /admin (comma separated emails)
ADMIN_EMAILS=""
