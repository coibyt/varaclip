generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  handle       String   @unique // @handle, lowercase a-z 0-9 _ .
  displayName  String
  bio          String   @default("") @db.VarChar(300)
  // A salon account can publish videos; a viewer account can only watch/like/comment.
  isSalon      Boolean  @default(false)
  salonName    String   @default("")
  city         String   @default("")
  bookingUrl   String   @default("") @db.VarChar(300)
  phone        String   @default("")
  avatarKey    String   @default("") @db.VarChar(512)
  hue          Int      @default(330) // fallback avatar colour
  createdAt    DateTime @default(now())

  videos    Video[]
  likes     Like[]
  saves     Save[]
  comments  Comment[]
  following Follow[]  @relation("follower")
  followers Follow[]  @relation("following")
  liveStreams  LiveStream[]
  chatMessages ChatMessage[]
  sentDMs      DirectMessage[] @relation("sentDM")
  receivedDMs  DirectMessage[] @relation("receivedDM")
}

model Video {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption     String   @default("") @db.VarChar(600)
  tags        String   @default("") @db.VarChar(255) // space separated, lowercase, no '#'
  // Either an object key in our storage (uploaded) or a full external URL (seed/demo).
  videoKey    String @db.VarChar(512)
  thumbKey    String   @default("") @db.VarChar(512)
  mimeType    String   @default("video/mp4")
  duration    Float    @default(0)
  width       Int      @default(0)
  height      Int      @default(0)
  views       Int      @default(0)
  shares      Int      @default(0)
  createdAt   DateTime @default(now())

  likes    Like[]
  saves    Save[]
  comments Comment[]

  @@index([createdAt])
  @@index([creatorId, createdAt])
}

model Like {
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, videoId])
  @@index([videoId])
}

model Save {
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, videoId])
}

model Comment {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String @db.VarChar(600)
  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

// ── Livestream + chat ───────────────────────────────────────────────

// One broadcast. The video itself plays on YouTube / Facebook / TikTok: the salon
// pastes the link of its live there, we embed it (TikTok cannot be embedded, so
// viewers get an "open on TikTok" button) and run the chat around it.
model LiveStream {
  id          String    @id @default(cuid())
  creatorId   String
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String    @default("") @db.VarChar(120)
  platform    String    @default("youtube") @db.VarChar(12) // youtube | facebook | tiktok
  sourceUrl   String    @default("") @db.VarChar(600)
  // YouTube: the video id (or "channel:UC..." for a channel live link); empty for the others.
  embedId     String    @default("") @db.VarChar(200)
  status      String    @default("LIVE") @db.VarChar(10) // LIVE | ENDED
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  peakViewers Int       @default(0)

  messages ChatMessage[]
  viewers  LiveViewer[]

  @@index([status, startedAt])
  @@index([creatorId, startedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  streamId  String
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String     @db.VarChar(300)
  deleted   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([streamId, createdAt])
}

// Who is watching right now: a row is refreshed on every chat poll.
model LiveViewer {
  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  key      String     @db.VarChar(64)
  lastSeen DateTime   @default(now())

  @@id([streamId, key])
  @@index([streamId, lastSeen])
}

// A salon blocking someone from chatting in any of its streams.
model ChatBan {
  creatorId String
  userId    String
  createdAt DateTime @default(now())

  @@id([creatorId, userId])
}

// ── Direct messages (1-to-1) ────────────────────────────────────────

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("sentDM", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("receivedDM", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String    @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
}

/// One row per device that installed the app ("installed") or opened it as an app ("opened").
model AppInstall {
  id        String   @id @default(cuid())
  deviceKey String   @db.VarChar(40)
  kind      String   @db.VarChar(12)
  platform  String   @db.VarChar(12)
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([deviceKey, kind])
}

/// What a person agreed to when signing up (kept apart from User so the consent can be audited).
model UserConsent {
  userId         String   @id
  marketingEmail Boolean  @default(false)
  marketingSms   Boolean  @default(false)
  termsAt        DateTime @default(now())
}

/// One row per visitor per day (Helsinki time); `views` counts the pages they opened that day.
model SiteVisit {
  id         String   @id @default(cuid())
  day        String   @db.VarChar(10)
  visitorKey String   @db.VarChar(40)
  userId     String?
  platform   String   @db.VarChar(12)
  views      Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([day, visitorKey])
  @@index([day])
}

/// A badge an admin chose by hand for a video ("hot", "new", or "none" to hide the automatic one).
model VideoBadge {
  videoId   String   @id
  badge     String   @db.VarChar(8)
  updatedAt DateTime @default(now()) @updatedAt
}

/// One-time links sent by email: "verify" (confirm the address) and "reset" (new password). Only a hash of the token is kept.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(10)
  tokenHash String    @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId, type])
}

/// Site-wide switches an admin can flip.
model SiteSetting {
  key       String   @id @db.VarChar(40)
  value     String   @db.VarChar(200)
  updatedAt DateTime @default(now()) @updatedAt
}

/// The category a video belongs to (one of the eight VaraaAi categories, see src/lib/categories.ts).
model VideoCategory {
  videoId  String @id
  category String @db.VarChar(24)

  @@index([category])
}

/// Personal API keys for posting software (see src/lib/api-keys.ts). Only a hash of the key is stored.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String    @db.VarChar(60)
  prefix     String    @db.VarChar(12)
  keyHash    String    @unique @db.VarChar(64)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}
